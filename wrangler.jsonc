{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Builds runs `npx wrangler deploy` from the repository root.
  // Keep this root entry point alongside the app-scoped config used by local
  // server development and integration tests.
  "name": "blokduo",
  "main": "apps/server/src/worker.ts",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // The custom domain, once blokduo.ca is a zone on Cloudflare.
  //
  // Left commented on purpose: wrangler fails the deploy if it is asked to
  // attach a route for a zone the account does not hold, and this repository
  // deploys on push — so uncommenting before the nameservers have moved would
  // break deploys rather than add a domain. Attach it in the dashboard first
  // (which checks the zone exists), or move the nameservers and uncomment.
  //
  // "routes": [
  //   { "pattern": "blokduo.ca", "custom_domain": true },
  //   { "pattern": "www.blokduo.ca", "custom_domain": true }
  // ],
  "assets": {
    "directory": "apps/web/dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDO"
      },
      {
        "name": "PROGRESS",
        "class_name": "ProgressDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["ProgressDO"]
    }
  ]
}
