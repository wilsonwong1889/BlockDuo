{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blokduo-server",
  "main": "src/worker.ts",
  // Pinned to what the installed workerd actually supports, so local dev and
  // tests run on the same runtime semantics as production rather than silently
  // falling back to an older date.
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ]
}
