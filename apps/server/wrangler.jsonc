{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Serves the whole game — site and rooms — so it is named for the game, not
  // for the half of it that started here.
  "name": "blokduo",
  "main": "src/worker.ts",
  // Pinned to what the installed workerd actually supports, so local dev and
  // tests run on the same runtime semantics as production rather than silently
  // falling back to an older date.
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },

  // The site and the room server ship as one Worker, on one origin.
  //
  // Assets are matched first and anything unmatched reaches the Worker, which
  // is exactly the split needed here: `/`, `/assets/*` and the icons are files,
  // `/api/*` is not. No SPA fallback is required because routing is done with
  // the hash (#/duo/CODE), so every request path is just `/`.
  //
  // Same origin also means the web client needs no configuration to find the
  // room server — only the native build, which is served from a bundle and has
  // no origin to be relative to, needs VITE_SERVER_URL.
  "assets": {
    "directory": "../web/dist"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "RoomDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RoomDO"]
    }
  ]
}
